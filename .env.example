# Copy to .env and fill in. Never commit .env.

# --- Supabase (remote dev project) ---
# Project Settings → API
SUPABASE_URL=https://jjynfsqpwktsckqrjfuu.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the dashboard.
SUPABASE_SECRET_KEY=

# Project Settings → Database → Connection string
# Session pooler (port 5432): migrations (drizzle-kit) and long-lived servers
DATABASE_URL=postgres://postgres.jjynfsqpwktsckqrjfuu:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Transaction pooler (port 6543): serverless runtimes (use prepare: false)
DATABASE_POOLER_URL=postgres://postgres.jjynfsqpwktsckqrjfuu:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Ports ---
API_PORT=3001
DASHBOARD_PORT=3010

# --- API ---
# Dev flag: `test` makes the bearer token just a user id, for trying the API with the Hono CLI
# against the local test DB. Never in production (the app refuses it).
# API_AUTH_VERIFIER=supabase

# --- Local Postgres (docker-compose.yml), used only by the API tests ---
# POSTGRES_USER=pollux
# POSTGRES_PASSWORD=pollux
# POSTGRES_DB=pollux
# POSTGRES_PORT=5433
# The suite drops and recreates this database on every run. It must be local and its name must
# contain "test". Tests never read DATABASE_URL. Default:
# TEST_DATABASE_URL=postgres://pollux:pollux@localhost:5433/pollux_test

# Supabase Auth user for local dev and seeds (create it in Supabase > Authentication)
TEST_USER=
TEST_PASS=
