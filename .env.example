# Copy to .env and fill in. Never commit .env.

# --- Supabase (remote dev project) ---
# Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the dashboard.
SUPABASE_SECRET_KEY=

# Project Settings → Database → Connection string
# Session pooler (port 5432): migrations (drizzle-kit) and long-lived servers
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Transaction pooler (port 6543): serverless runtimes (use prepare: false)
DATABASE_POOLER_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Ports ---
API_PORT=3001
DASHBOARD_PORT=3010

# --- Optional local Postgres (docker-compose.yml) for a future self-hosted move. Not in use. ---
# POSTGRES_USER=pollux
# POSTGRES_PASSWORD=pollux
# POSTGRES_DB=pollux
# POSTGRES_PORT=5433
