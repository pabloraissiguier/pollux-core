{
  "name": "pollux-core",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "dev:dashboard": "pnpm --filter dashboard dev",
    "build:dashboard": "pnpm --filter dashboard build",
    "db:generate": "pnpm --filter @pollux/db generate",
    "db:migrate": "pnpm --filter @pollux/db migrate",
    "db:seed": "pnpm --filter @pollux/db seed"
  }
}
