{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "hono",
      "installCommand": "pnpm install --frozen-lockfile --config.engine-strict=false"
    },
    "dashboard": {
      "root": "apps/dashboard",
      "framework": "nuxtjs",
      "installCommand": "pnpm install --frozen-lockfile --config.engine-strict=false"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "dashboard" }
    }
  ]
}
